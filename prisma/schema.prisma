// Generate the Prisma client for JavaScript/TypeScript usage
generator client {
  provider = "prisma-client-js" // Prisma Client will be used to interact with the database
}

// Define the datasource using PostgreSQL with the connection URL from an environment variable
datasource db {
  provider = "postgresql" // PostgreSQL is the chosen database provider
  url      = env("DATABASE_URL") // The database URL is stored in an environment variable for security
}

// ==================================================================================
// User Model & Related Models
// ==================================================================================
model User {
  id             String     @id @default(cuid()) // Unique identifier, auto-generated with cuid()
  email          String     @unique             // Unique email address for each user
  name           String?                           // Optional name field
  emailVerified  DateTime?                         // Optional field for email verification timestamp
  image          String?                           // Optional URL for the user's profile image
  googleId       String?    @unique             // Optional unique Google ID for authentication
  createdAt      DateTime   @default(now())       // Timestamp when the user was created
  updatedAt      DateTime   @updatedAt            // Automatically updated timestamp on modification
  visible        Boolean    @default(false)       // Controls if the user is publicly visible
  tag            String     @default("USER")  
  // NextAuth relations
  accounts       Account[]   // A user can have multiple authentication accounts
  sessions       Session[]   // A user can have multiple active sessions
 
  

  // Rating system relations
  ratingsGiven    Rating[]   @relation("RatedBy")    // Ratings given by this user
  receivedRatings Rating[]   @relation("RatedUser")  // Ratings received by this user

  // Comment system relations
  commentsGiven    Comment[]  @relation("CommentsGiven")    // Comments authored by this user
  commentsReceived Comment[]  @relation("CommentsReceived") // Comments received by this user
  reportsMade      CommentReport[] @relation("ReportsMade") // Reports made by this user
}

model Account {
  id                 String   @id @default(cuid())
  userId             String   // Foreign key referencing User
  type               String   // Type of account (e.g., "oauth")
  provider           String   // Name of the authentication provider (e.g., Google)
  providerAccountId  String   // Unique identifier provided by the provider
  refresh_token      String?  // Optional refresh token for obtaining new access tokens
  access_token       String?  // Optional access token for API calls
  expires_at         Int?     // Optional expiration time for the tokens
  token_type         String?  // Optional token type (e.g., "Bearer")
  scope              String?  // Optional scope of the access request
  id_token           String?  // Optional ID token used for authentication
  session_state      String?  // Optional session state

  // Relation: linking to the User
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String   // Foreign key referencing User
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String  // Typically the user's email
  token      String  @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================================================================================
// Rating Model (Polymorphic: Users and Articles)
// ==================================================================================
model Rating {
  id             String   @id @default(cuid())
  value          Int      // Numeric rating (e.g., 1 to 5)
  comment        String?  // Optional comment explaining the rating
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The user who gave the rating
  userId         String
  user           User     @relation("RatedBy", fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic fields: either a user or an article is rated
  ratedUserId    String?  // ID of the user being rated (null if rating an article)
  ratedUser      User?    @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)

  ratedArticleId String?  // ID of the article being rated (null if rating a user)
  ratedArticle   Article? @relation(fields: [ratedArticleId], references: [id], onDelete: Cascade)

  // NOTE: Check constraints to enforce that either ratedUserId or ratedArticleId must be provided
  // are not currently supported in Prisma schema (or are in preview); therefore, they are omitted.

  @@unique([userId, ratedUserId])
  @@unique([userId, ratedArticleId])
}

// ==================================================================================
// Comment & CommentReport Models
// ==================================================================================
model Comment {
  id           String   @id @default(cuid())
  content      String   // Comment text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visible      Boolean  @default(true)

  // Relation: author of the comment
  authorId     String
  author       User     @relation("CommentsGiven", fields: [authorId], references: [id], onDelete: Cascade)

  // Relation: target user receiving the comment
  targetUserId String
  targetUser   User     @relation("CommentsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  reports      CommentReport[]
}

model CommentReport {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  // The user who reported the comment
  reporterUserId String
  reporter       User     @relation("ReportsMade", fields: [reporterUserId], references: [id], onDelete: Cascade)

  // The comment that was reported
  commentId      String
  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterUserId, commentId])
}

// ==================================================================================
// New Models: Event and Article
// ==================================================================================
model Event {
  id          String    @id @default(cuid()) // Unique identifier for the event
  title        String    // Title of the event
  description String?   // Optional detailed description
  startDate   DateTime  // When the event begins
  endDate     DateTime  // When the event ends
  isActive    Boolean   @default(true)  // Active status toggle
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relation: Articles associated with this event
  articles    Article[]
}

model Article {
  id          String    @id @default(cuid()) // Unique identifier for the article
  name       String    // Title of the article
  description     String    // Content/body of the article
  visible     Boolean   @default(true) // Visibility toggle for the article
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relation: The event this article belongs to
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Relation: Ratings received for this article (polymorphic Rating model uses ratedArticleId)
  ratings     Rating[]
}
